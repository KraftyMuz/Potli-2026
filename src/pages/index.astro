---
import Potli from "../layouts/Potli.astro";
import site from "../content/site.json";
import home from "../content/home.json";
import reviews from "../content/reviews.json";

const { hero, signatures, storyBand, findUs, cta } = home;

// Presentation-only: the alternating paper tilts on the review notes.
const TILTS = ["-rotate-[1.5deg]", "rotate-[1deg]", "-rotate-[1deg]", "rotate-[1.5deg]", "-rotate-[1deg]"];
---

<Potli
  title={home.seo.title}
  description={home.seo.description}
  ogTitle={home.seo.ogTitle}
  ogDescription={home.seo.ogDescription}
>
  <div>
    {/* 1 — Hero: asymmetric split, photo bleeding off the right edge */}
    <section class="grid items-stretch bg-background md:min-h-[calc(100vh-4rem)] md:grid-cols-[45fr_55fr]">
      <div class="order-2 flex flex-col justify-center gap-5 px-6 py-10 md:order-1 md:px-12 lg:px-16">
        <img src={site.logo} alt={`${site.name} — ${site.tagline}`} class="h-16 w-auto self-start" />
        <h1 class="heading-rule font-display text-6xl leading-[0.92] sm:text-7xl lg:text-8xl">{hero.heading}</h1>
        <p class="max-w-md text-lg text-muted-foreground">{hero.intro}</p>

        <div class="flex flex-wrap gap-3">
          <a href={hero.primaryCta.href} class="btn btn-lg text-base">
            {hero.primaryCta.label}
            <svg
              class="ml-1 h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
          <a href={hero.secondaryCta.href} class="btn btn-lg btn-outline border-charcoal text-base text-charcoal">
            <svg
              class="mr-1 h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
              <path d="M3 6h18"></path>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            {hero.secondaryCta.label}
          </a>
        </div>

        <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-muted-foreground">
          <span class="flex items-center gap-1.5">
            <svg
              class="h-4 w-4 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            {site.contact.streetAddress}, {site.contact.addressLocality}
          </span>
          <a href={site.contact.phoneHref} class="flex items-center gap-1.5 hover:text-primary">
            <svg
              class="h-4 w-4 text-foreground/60"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z"
              ></path>
            </svg>
            {site.contact.phone}
          </a>
        </div>
      </div>

      <div class="relative order-1 aspect-[4/3] border-l-4 border-charcoal md:order-2 md:aspect-auto">
        <img
          src={hero.image}
          alt={hero.imageAlt}
          class="absolute inset-0 h-full w-full object-cover"
          width={hero.imageWidth}
          height={hero.imageHeight}
        />
        <span
          class="hard-shadow absolute bottom-5 left-5 -rotate-3 border-2 border-charcoal bg-background px-4 py-1.5 font-hand text-lg font-bold text-charcoal"
        >
          {hero.stickerLabel}
        </span>
      </div>
    </section>

    {/* 2 — Ratings strip */}
    <section class="sign-panel bg-charcoal px-4 py-4 text-background">
      <div class="grid gap-3 text-center sm:grid-cols-3">
        {
          reviews.ratings.map((r) => (
            <div>
              <p class="font-sans text-3xl font-bold text-primary">
                {r.big}
                {r.small && <span class="ml-2 font-sans text-base text-background/70">{r.small}</span>}
              </p>
              <p class="text-sm text-background/70">{r.note}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/* 3 — Signature dishes */}
    <section class="sign-panel panel-color bg-secondary px-6 pb-10 pt-16 lg:px-10 lg:pt-20">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="font-hand text-lg leading-tight opacity-80">{signatures.eyebrow}</p>
          <h2 class="heading-rule font-display text-5xl md:text-6xl">{signatures.heading}</h2>
        </div>
        <a href={signatures.ctaHref} class="btn btn-outline">
          {signatures.ctaLabel}
          <svg
            class="ml-1 h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <div class="grid items-start gap-6 lg:grid-cols-[3fr_2fr]">
        <article class="hard-shadow group self-start overflow-hidden border-2 border-charcoal bg-card lg:h-full">
          <div
            class="aspect-[4/3] overflow-hidden border-b-2 border-charcoal lg:aspect-auto lg:h-[calc(100%-7.5rem)] lg:min-h-0"
          >
            <img
              src={signatures.cards[0].image}
              alt={signatures.cards[0].name}
              loading="lazy"
              width="640"
              height="480"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div class="p-4">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-2xl leading-[1.05] tracking-[-0.01em]">{signatures.cards[0].name}</h3>
              <span class="shrink-0 font-hand text-2xl text-brand-red">{signatures.cards[0].price}</span>
            </div>
            <p class="mt-1 text-lg leading-snug text-foreground/85">{signatures.cards[0].description}</p>
          </div>
        </article>

        <div class="grid items-start gap-6 self-start">
          {
            signatures.cards.slice(1, 3).map((dish) => (
              <article class="hard-shadow group self-start overflow-hidden border-2 border-charcoal bg-card">
                <div class="aspect-[16/9] overflow-hidden border-b-2 border-charcoal">
                  <img
                    src={dish.image}
                    alt={dish.name}
                    loading="lazy"
                    width="640"
                    height="480"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
                <div class="p-4">
                  <div class="flex items-baseline justify-between gap-3">
                    <h3 class="font-display text-2xl leading-[1.05] tracking-[-0.01em]">{dish.name}</h3>
                    <span class="shrink-0 font-hand text-2xl text-brand-red">{dish.price}</span>
                  </div>
                  <p class="mt-1 text-lg leading-snug text-foreground/85">{dish.description}</p>
                </div>
              </article>
            ))
          }
        </div>

        <div class="hard-shadow relative border-2 border-charcoal bg-primary p-6 text-charcoal lg:col-span-2">
          <span
            class="hard-shadow absolute -right-2 -top-3 z-10 flex min-h-14 w-24 -rotate-3 items-center justify-center border-2 border-charcoal bg-background p-2 text-center font-hand text-xs font-bold leading-tight text-charcoal"
          >
            {signatures.featureBadge}
          </span>
          <div class="pr-24">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-display text-2xl leading-[1.05] tracking-[-0.01em]">{signatures.feature.name}</h3>
              <p class="font-hand text-2xl text-brand-red">{signatures.feature.price}</p>
            </div>
            <p class="mt-2 text-lg leading-snug text-foreground/85">{signatures.feature.description}</p>
            <p class="mt-3 text-sm font-semibold text-charcoal">{signatures.feature.note}</p>
          </div>
        </div>
      </div>
    </section>

    {/* 4 — Full-bleed food band with the story */}
    <section class="relative border-t-4 border-charcoal">
      <img
        src={storyBand.image}
        alt={storyBand.imageAlt}
        loading="lazy"
        width={storyBand.imageWidth}
        height={storyBand.imageHeight}
        class="h-[520px] w-full object-cover md:h-[600px]"
      />
      <div class="absolute inset-0 bg-charcoal/65"></div>
      <div class="absolute inset-0 flex items-center">
        <div class="mx-auto w-full max-w-5xl px-6 text-background">
          <h2 class="heading-rule max-w-3xl font-display text-5xl leading-[0.95] md:text-7xl">{storyBand.heading}</h2>
          <div class="mt-6 grid max-w-3xl gap-5 md:grid-cols-2">
            {storyBand.columns.map((c) => <p class="text-background/85">{c}</p>)}
          </div>
          <a href={storyBand.linkHref} class="mt-6 inline-flex items-center gap-2 font-semibold text-primary underline">
            {storyBand.linkLabel}
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    {/* 5 — Reviews and press */}
    <section class="sign-panel panel-color bg-orange">
      <div class="w-full overflow-hidden opacity-70" style="height: 14px" aria-hidden="true">
        <svg width="100%" height="14" role="presentation">
          <defs>
            <pattern id="reviews-motif" width="48" height="12" patternUnits="userSpaceOnUse">
              <path
                d="M0 10 Q6 2 12 10 T24 10 T36 10 T48 10"
                fill="none"
                stroke="#252525"
                stroke-width="1.1"
                stroke-linecap="round"></path>
              <circle cx="6" cy="4" r="1.1" fill="#252525"></circle>
              <circle cx="18" cy="4" r="1.1" fill="#252525"></circle>
              <circle cx="30" cy="4" r="1.1" fill="#252525"></circle>
              <circle cx="42" cy="4" r="1.1" fill="#252525"></circle>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#reviews-motif)"></rect>
        </svg>
      </div>

      <div class="mx-auto max-w-6xl px-6 pb-6 pt-10 lg:px-10">
        <div class="flex flex-wrap items-end justify-between gap-5">
          <div>
            <p class="font-hand text-lg leading-tight opacity-80">{reviews.eyebrow}</p>
            <h2 class="heading-rule font-display text-5xl md:text-6xl">{reviews.heading}</h2>
          </div>
          <a href={reviews.googleReviewsUrl} target="_blank" rel="noreferrer" class="btn btn-outline">
            {reviews.ctaLabel}
          </a>
        </div>

        <div class="mt-8 grid auto-rows-fr gap-6 sm:grid-cols-2">
          {
            reviews.quotes.map((q, i) => (
              <div
                class:list={[
                  "torn-note-shadow h-full transition-transform duration-300 hover:rotate-0",
                  TILTS[i % TILTS.length],
                  i === reviews.quotes.length - 1 ? "sm:col-span-2 sm:max-w-md sm:justify-self-center" : "",
                ]}
              >
                <figure class="torn-note flex h-full flex-col justify-between bg-card p-5 text-foreground">
                  <blockquote class="text-base leading-snug">“{q.quote}”</blockquote>
                  <figcaption class="mt-3 font-sans text-sm text-brand-red">— {q.by}</figcaption>
                </figure>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="border-t-4 border-charcoal bg-background px-6 py-4 lg:px-10">
      <div class="mx-auto max-w-6xl">
        <h2 class="font-display text-4xl text-charcoal">{reviews.pressHeading}</h2>
        <div class="mt-4 flex flex-wrap gap-x-10 gap-y-3">
          {reviews.press.map((name) => <span class="font-display text-2xl text-charcoal">{name}</span>)}
        </div>
      </div>
    </section>

    {/* 6 — Find us */}
    <section class="sign-panel panel-color grid items-stretch bg-lime md:grid-cols-2">
      <div class="relative min-h-[340px] border-r-4 border-charcoal md:min-h-[520px]">
        <img
          src={findUs.image}
          alt={findUs.imageAlt}
          loading="lazy"
          width={findUs.imageWidth}
          height={findUs.imageHeight}
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
      <div class="flex flex-col justify-center gap-5 px-6 py-10 md:px-12 lg:px-16">
        <div>
          <p class="font-hand text-lg leading-tight opacity-80">{findUs.eyebrow}</p>
          <h2 class="heading-rule font-display text-5xl md:text-6xl">{findUs.heading}</h2>
        </div>
        <p class="text-lg text-charcoal/80">{findUs.body}</p>
        <p class="text-charcoal/80">{findUs.classesLead}</p>
        <div class="flex flex-wrap gap-3">
          <a href={site.contact.phoneHref} class="btn btn-outline">Directions &amp; opening hours</a>
          <a href={site.contact.phoneHref} class="flex items-center gap-2 self-center font-semibold hover:text-primary">
            <svg
              class="h-4 w-4 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z"
              ></path>
            </svg>
            {site.contact.phone}
          </a>
        </div>
      </div>
    </section>

    {/* 7 — Saffron CTA band */}
    <section class="sign-panel panel-color relative bg-primary text-primary-foreground">
      <div class="w-full overflow-hidden opacity-90" style="height: 20px" aria-hidden="true">
        <svg width="100%" height="20" role="presentation">
          <defs>
            <pattern id="cta-motif" width="48" height="12" patternUnits="userSpaceOnUse">
              <path
                d="M0 10 Q6 2 12 10 T24 10 T36 10 T48 10"
                fill="none"
                stroke="#252525"
                stroke-width="1.2"
                stroke-linecap="round"></path>
              <circle cx="6" cy="4" r="1.2" fill="#252525"></circle>
              <circle cx="18" cy="4" r="1.2" fill="#252525"></circle>
              <circle cx="30" cy="4" r="1.2" fill="#252525"></circle>
              <circle cx="42" cy="4" r="1.2" fill="#252525"></circle>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#cta-motif)"></rect>
        </svg>
      </div>

      <div class="px-6 pb-12 pt-10 lg:px-10">
        <span class="inline-block -rotate-3 font-hand text-lg font-bold text-charcoal">{cta.sticker}</span>
        <div class="mt-2">
          <p class="font-hand text-lg leading-tight text-charcoal opacity-80">{cta.eyebrow}</p>
          <h2 class="heading-rule heading-rule-charcoal max-w-2xl font-display text-5xl text-charcoal md:text-6xl">
            {cta.heading}
          </h2>
        </div>
        <p class="mt-3 max-w-xl text-lg text-charcoal/90">{cta.intro}</p>

        <div class="mt-9 grid gap-8 sm:grid-cols-2">
          <div>
            <a href={cta.book.href} class="btn btn-lg w-full px-8 py-6 text-lg sm:w-auto">
              <svg
                class="mr-2 h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                style="color: var(--brand-red)"
                aria-hidden="true"
              >
                <path d="M9 9.5c-2 1.2-3.5 3.2-3.5 5.4A6.5 6.5 0 0 0 12 21a6.5 6.5 0 0 0 6.5-6.1c0-2.2-1.5-4.2-3.5-5.4"
                ></path>
                <path d="M9 9.5c1 .6 2 .9 3 .9s2-.3 3-.9"></path>
                <path d="M9.5 9.5 9 6.5M14.5 9.5l.5-3"></path>
                <path d="M12 6V3.5"></path>
                <path d="M9.5 4.2 12 3.5l2.5.7"></path>
              </svg>
              {cta.book.label}
            </a>
            <p class="mt-3 max-w-xs text-charcoal/90">{cta.book.note}</p>
          </div>
          <div>
            <a href={cta.order.href} class="btn btn-lg btn-accent w-full px-8 py-6 text-lg sm:w-auto">
              <svg
                class="mr-2 h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
                <path d="M3 6h18"></path>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              {cta.order.label}
            </a>
            <p class="mt-3 max-w-xs text-charcoal/90">{cta.order.note}</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Potli>
